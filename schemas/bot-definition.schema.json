{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trentbest.github.io/TheSingularityWorkshop.SingularityBot/schemas/bot-definition.schema.json",
  "title": "SingularityBot BotDefinition",
  "description": "Complete, GUI-independent saved bot artifact. Runtime controls and telemetry are session state and do not belong here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "game", "strategy", "unitProfiles"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string" }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "race"],
      "properties": {
        "id": { "const": "starcraft-ii" },
        "adapter": { "const": "sc2" },
        "race": { "enum": ["Terran", "Zerg", "Protoss", "Random"] }
      }
    },
    "strategy": { "$ref": "./strategy-payload.schema.json" },
    "unitProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "role", "profileId", "catalogVersion", "overrides"],
        "properties": {
          "unitId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "profileId": { "type": "string", "minLength": 1 },
          "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "retreatWhenOutmatched": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}