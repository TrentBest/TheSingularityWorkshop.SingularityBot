{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SingularityBot Goal Action Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "defaultRole", "scoutCount", "scoutSectors", "excludeEnemyStartSector", "stutterStepEnabled", "fallbackHealthFraction", "engageVisibleThreats"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "defaultRole": { "enum": ["Rally", "Scout", "Contain", "Engage", "Fallback"] },
    "scoutCount": { "type": "integer", "minimum": 0, "maximum": 9 },
    "scoutSectors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column", "row"],
        "properties": {
          "column": { "type": "integer", "minimum": 0, "maximum": 2 },
          "row": { "type": "integer", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "excludeEnemyStartSector": { "type": "boolean" },
    "stutterStepEnabled": { "type": "boolean" },
    "fallbackHealthFraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "engageVisibleThreats": { "type": "boolean" }
  }
}
