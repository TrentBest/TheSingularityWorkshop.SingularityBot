<Window x:Class="TheSingularityWorkshop.SingularityBot.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SingularityBot Forge" Height="900" Width="1440" MinHeight="680" MinWidth="1080" Background="#070D18" Foreground="#E8F1FA">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#0D1929" BorderBrush="#20364D" BorderThickness="0,0,0,1" Padding="22,14"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="THE SINGULARITY WORKSHOP" Foreground="#00A8FF" FontSize="11" FontWeight="Bold"/><TextBlock Text="SINGULARITYBOT / FORGE" FontSize="22" FontWeight="SemiBold"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="AUTHORING WORKSPACE · SYNTHETIC EXAMPLE" Foreground="#8DA7BE" VerticalAlignment="Center"/></DockPanel></Border>
<Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0B1523" BorderBrush="#20364D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="BOT DEFINITION" Foreground="#00A8FF" FontWeight="Bold" Margin="0,0,0,12"/><TreeView x:Name="AuthoringTree" Background="Transparent" BorderThickness="0" Foreground="#DCE8F4"><TreeViewItem Header="Terran — Safe Marine" IsExpanded="True"><TreeViewItem Header="Strategy" IsExpanded="True"><TreeViewItem Header="Opening"/><TreeViewItem Header="Pressure"/></TreeViewItem><TreeViewItem Header="Groups" IsExpanded="True"><TreeViewItem Header="Economy Group"/><TreeViewItem Header="Marine Squad"/></TreeViewItem><TreeViewItem Header="Unit Profiles" IsExpanded="True"><TreeViewItem Header="SCV — Worker"/><TreeViewItem Header="Marine — Infantry"/></TreeViewItem><TreeViewItem Header="Behavior Library" IsExpanded="True"><TreeViewItem Header="Gather"/><TreeViewItem Header="Build"/><TreeViewItem Header="Defend"/><TreeViewItem Header="Pressure"/><TreeViewItem Header="Retreat"/><TreeViewItem Header="Regroup"/></TreeViewItem></TreeViewItem></TreeView></DockPanel></Border>
<Border Grid.Column="1" Background="#0B1523" BorderBrush="#20364D" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,12,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="STRATEGY OVERVIEW" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="Build the bot's behavior, not its code." FontSize="27" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="Describe the goal, organize it into phases, assign shared objectives to groups, and give each unit a reusable profile." Foreground="#A9BED1" TextWrapping="Wrap" Margin="0,0,0,20"/>
<Border Background="#13263A" CornerRadius="6" Padding="14" Margin="0,0,0,16"><StackPanel><TextBlock Text="SYNTHETIC AUTHORING FIXTURE" Foreground="#FFD27A" FontWeight="Bold"/><TextBlock Text="Sample strategy content for exercising the editor. This is not live map data, a runtime snapshot, or an executable bot." Foreground="#D7E2ED" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
<TextBlock Text="1. Opening" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Protect the economy while establishing basic production." Foreground="#A9BED1" Margin="0,4,0,14"/><TextBlock Text="2. Pressure" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use the Marine squad to apply controlled pressure while preserving a retreat path." Foreground="#A9BED1" Margin="0,4,0,18"/>
<TextBlock Text="GROUPS &amp; SHARED OBJECTIVES" Foreground="#00A8FF" FontWeight="Bold" Margin="0,0,0,10"/><UniformGrid Columns="2"><Border Background="#102033" CornerRadius="6" Padding="12" Margin="0,0,8,8"><StackPanel><TextBlock Text="Economy Group" FontWeight="SemiBold"/><TextBlock Text="SCV membership · gather/build" Foreground="#A9BED1" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#102033" CornerRadius="6" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="Marine Squad" FontWeight="SemiBold"/><TextBlock Text="Shared defend/pressure objective" Foreground="#A9BED1" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid>
<TextBlock Text="BEHAVIOR RULE PREVIEW" Foreground="#00A8FF" FontWeight="Bold" Margin="0,12,0,8"/><Border Background="#102033" CornerRadius="6" Padding="12"><TextBlock Text="When a Marine's health ratio falls below the authored retreat threshold, propose a retreat intent. The runtime must validate the fact, target and action before execution." TextWrapping="Wrap" Foreground="#D7E2ED"/></Border>
</StackPanel></ScrollViewer></Border>
<Border Grid.Column="2" Background="#0B1523" BorderBrush="#20364D" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="INSPECTOR" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="Selected: Bot Definition" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,14"/><TextBlock Text="Identity" Foreground="#8DA7BE" FontWeight="Bold"/><TextBlock Text="Terran — Safe Marine" Margin="0,4,0,12"/><TextBlock Text="Race" Foreground="#8DA7BE" FontWeight="Bold"/><TextBlock Text="Terran" Margin="0,4,0,12"/><TextBlock Text="Schema" Foreground="#8DA7BE" FontWeight="Bold"/><TextBlock Text="BotDefinition 1.0" Margin="0,4,0,12"/><Separator Background="#20364D" Margin="0,4,0,12"/><TextBlock Text="AUTHORING RULE" Foreground="#FFD27A" FontWeight="Bold"/><TextBlock Text="Defaults and explicit overrides remain distinguishable. LLM edits are proposals; nothing is saved or applied without your approval." TextWrapping="Wrap" Foreground="#D7E2ED" Margin="0,6,0,0"/></StackPanel></Border>
</Grid>
<Border Grid.Row="2" Background="#0D1929" BorderBrush="#20364D" BorderThickness="0,1,0,0" Padding="18,10"><DockPanel><TextBlock Text="Ready · No runtime connected · No live map loaded" Foreground="#8DA7BE"/><TextBlock DockPanel.Dock="Right" Text="FORGE AUTHORING PREVIEW" Foreground="#00A8FF"/></DockPanel></Border>
</Grid></Window>