<Window x:Class="TheSingularityWorkshop.SingularityBot.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SingularityBot Forge" Height="900" Width="1500" MinHeight="700" MinWidth="1120" Background="#070D18" Foreground="#E8F1FA">
<Window.Resources>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE8F4"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#102033"/><Setter Property="Foreground" Value="#F2F7FC"/><Setter Property="BorderBrush" Value="#35516B"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="#0B1523"/><Setter Property="Foreground" Value="#DCE8F4"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#17466A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#28658F"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
</Window.Resources>
<DockPanel>
<Border DockPanel.Dock="Top" Background="#0D1929" BorderBrush="#20364D" BorderThickness="0,0,0,1" Padding="20,13"><DockPanel><StackPanel><TextBlock Text="THE SINGULARITY WORKSHOP" Foreground="#00A8FF" FontSize="11" FontWeight="Bold"/><TextBlock Text="SINGULARITYBOT / FORGE" FontSize="22" FontWeight="SemiBold"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Validate draft" Click="Validate_Click"/><Button Content="Load draft" Click="Load_Click"/><Button Content="Save draft" Click="Save_Click" Background="#087C68"/></StackPanel></DockPanel></Border>
<Border DockPanel.Dock="Bottom" Background="#0D1929" BorderBrush="#20364D" BorderThickness="0,1,0,0" Padding="14,9"><TextBlock Text="{Binding Status}" Foreground="#9CB2C7"/></Border>
<Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0B1523" BorderBrush="#20364D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="AUTHORING TREE" Foreground="#00A8FF" FontWeight="Bold" Margin="0,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="STRATEGY PHASES" Foreground="#8DA7BE" FontWeight="Bold"/><ListBox ItemsSource="{Binding Phases}" SelectedItem="{Binding SelectedPhase}" DisplayMemberPath="Name" Height="105" Margin="0,5,0,8"/><Button Content="+ Add phase" Click="AddPhase_Click" HorizontalAlignment="Left"/>
<TextBlock Text="GROUPS / SQUADS" Foreground="#8DA7BE" FontWeight="Bold" Margin="0,15,0,0"/><ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Height="120" Margin="0,5,0,8"/><Button Content="+ Add group" Click="AddGroup_Click" HorizontalAlignment="Left"/>
<TextBlock Text="UNIT PROFILES" Foreground="#8DA7BE" FontWeight="Bold" Margin="0,15,0,0"/><ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="UnitId" Height="100" Margin="0,5,0,8"/>
<TextBlock Text="REUSABLE BEHAVIORS" Foreground="#8DA7BE" FontWeight="Bold" Margin="0,15,0,0"/><ListBox ItemsSource="{Binding Behaviors}" SelectedItem="{Binding SelectedBehavior}" DisplayMemberPath="Id" Height="95" Margin="0,5,0,8"/><Button Content="+ Add behavior" Click="AddBehavior_Click" HorizontalAlignment="Left"/><TextBlock Text="BEHAVIOR RULES" Foreground="#8DA7BE" FontWeight="Bold" Margin="0,15,0,0"/><ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="Id" Height="100" Margin="0,5,0,8"/><Button Content="+ Add rule" Click="AddRule_Click" HorizontalAlignment="Left"/>
</StackPanel></ScrollViewer></DockPanel></Border>
<Border Grid.Column="1" Background="#0B1523" BorderBrush="#20364D" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,12,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="BOT IDENTITY" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="Name"/><TextBox Text="{Binding BotName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Race"/><TextBox Text="{Binding Race, UpdateSourceTrigger=PropertyChanged}"/>
<Separator Background="#20364D" Margin="0,10,0,14"/><TextBlock Text="SELECTED PHASE" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="Select a phase in the left panel to edit its objective, name and priority." Foreground="#9CB2C7" Margin="0,5,0,4"/><TextBlock Text="Phase name"/><TextBox Text="{Binding SelectedPhase.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Objective"/><TextBox Text="{Binding SelectedPhase.Objective, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/><TextBlock Text="Priority"/><TextBox Text="{Binding SelectedPhase.Priority, UpdateSourceTrigger=PropertyChanged}"/>
<Separator Background="#20364D" Margin="0,10,0,14"/><TextBlock Text="GROUP / SQUAD AUTHORING" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="A group owns its shared objective and coordination policy. Members keep their own unit profiles." Foreground="#9CB2C7" TextWrapping="Wrap" Margin="0,5,0,8"/><TextBlock Text="Group name"/><TextBox Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Membership selector"/><TextBox Text="{Binding SelectedGroup.MembershipSelector, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Shared objective"/><TextBox Text="{Binding SelectedGroup.SharedObjective, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/><TextBlock Text="Coordination policy"/><TextBox Text="{Binding SelectedGroup.CoordinationPolicy, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
<Separator Background="#20364D" Margin="0,10,0,14"/><TextBlock Text="REUSABLE BEHAVIOR" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="Behavior ID"/><TextBox Text="{Binding SelectedBehavior.Id, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Catalog behavior ID"/><TextBox Text="{Binding SelectedBehavior.CatalogId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Catalog version"/><TextBox Text="{Binding SelectedBehavior.CatalogVersion, UpdateSourceTrigger=PropertyChanged}"/><Separator Background="#20364D" Margin="0,10,0,14"/><TextBlock Text="RULE AUTHORING" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="Fact IDs and candidate intent IDs are provisional until confirmed by runtime-owned catalogs." Foreground="#FFD27A" TextWrapping="Wrap" Margin="0,5,0,8"/><TextBlock Text="Rule ID"/><TextBox Text="{Binding SelectedRule.Id, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Behavior reference"/><TextBox Text="{Binding SelectedRule.BehaviorId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Fact ID"/><TextBox Text="{Binding SelectedRule.FactId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Operator"/><ComboBox SelectedValue="{Binding SelectedRule.Operator, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Background="#102033" Foreground="#F2F7FC" Padding="6" Margin="0,4,0,10"><ComboBoxItem Content="lessThan"/><ComboBoxItem Content="lessThanOrEqual"/><ComboBoxItem Content="greaterThan"/><ComboBoxItem Content="greaterThanOrEqual"/><ComboBoxItem Content="equals"/></ComboBox><TextBlock Text="Threshold / value"/><TextBox Text="{Binding SelectedRule.Value, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Candidate intent ID"/><TextBox Text="{Binding SelectedRule.CandidateIntentId, UpdateSourceTrigger=PropertyChanged}"/>
</StackPanel></ScrollViewer></Border>
<Border Grid.Column="2" Background="#0B1523" BorderBrush="#20364D" BorderThickness="1" CornerRadius="8" Padding="15"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="PROFILE INSPECTOR" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="Unit"/><TextBox Text="{Binding SelectedProfile.UnitId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Role"/><TextBox Text="{Binding SelectedProfile.Role, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Profile catalog ID"/><TextBox Text="{Binding SelectedProfile.ProfileCatalogId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Catalog version"/><TextBox Text="{Binding SelectedProfile.CatalogVersion, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Retreat health ratio override"/><TextBox Text="{Binding SelectedProfile.RetreatHealthRatio, UpdateSourceTrigger=PropertyChanged}"/>
<Border Background="#13263A" CornerRadius="6" Padding="12" Margin="0,8,0,12"><StackPanel><TextBlock Text="DEFAULTS VS OVERRIDES" Foreground="#FFD27A" FontWeight="Bold"/><TextBlock Text="Catalog defaults are referenced, not copied. A non-empty retreat threshold is an authored local override. The real catalog must confirm supported fields and valid ranges." Foreground="#D7E2ED" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
<TextBlock Text="WORKSPACE LIMITS" Foreground="#00A8FF" FontWeight="Bold"/><TextBlock Text="Synthetic authoring fixture only. No live map, match snapshot, runner commands, or authoritative catalog/validation connection is available in this shell." Foreground="#9CB2C7" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="LLM proposals must be reviewed as a scoped diff and explicitly approved before saving or applying." Foreground="#D7E2ED" TextWrapping="Wrap" Margin="0,14,0,0"/>
</StackPanel></ScrollViewer></Border>
</Grid></DockPanel></Window>