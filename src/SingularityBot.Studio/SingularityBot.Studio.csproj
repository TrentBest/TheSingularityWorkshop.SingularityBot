<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SingularityBot/SingularityBot.csproj" />
    <ProjectReference Include="../../../TheSingularityWorkshop.GUI/src/Core/TheSingularityWorkshop.GUI.Core.csproj"
                      Condition="Exists('../../../TheSingularityWorkshop.GUI/src/Core/TheSingularityWorkshop.GUI.Core.csproj')" />
    <ProjectReference Include="../../../TheSingularityWorkshop.GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj"
                      Condition="Exists('../../../TheSingularityWorkshop.GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj')" />
    <ProjectReference Include="../../dependencies/GUI/src/Core/TheSingularityWorkshop.GUI.Core.csproj"
                      Condition="!Exists('../../../TheSingularityWorkshop.GUI/src/Core/TheSingularityWorkshop.GUI.Core.csproj')" />
    <ProjectReference Include="../../dependencies/GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj"
                      Condition="!Exists('../../../TheSingularityWorkshop.GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj')" />
  </ItemGroup>
  <Target Name="RequireWorkshopGuiSources" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('../../../TheSingularityWorkshop.GUI/src/Core/TheSingularityWorkshop.GUI.Core.csproj') and !Exists('../../dependencies/GUI/src/Core/TheSingularityWorkshop.GUI.Core.csproj')"
           Text="The Workshop GUI Core source checkout is required." />
    <Error Condition="!Exists('../../../TheSingularityWorkshop.GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj') and !Exists('../../dependencies/GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj')"
           Text="The Workshop GUI WPF source checkout is required." />
  </Target>
</Project>
